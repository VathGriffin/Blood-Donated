# Copy to .env and fill in real values. Never commit .env.

# Database (MongoDB Atlas: allow your host's IPs — for most hosts that means 0.0.0.0/0)
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/blood-donation

# Long random strings, different from each other
JWT_SECRET=
QR_JWT_SECRET=

PORT=3001

# The first admin account, created on first start if none exists
ADMIN_EMAIL=admin@example.com
# bcrypt hash of the admin password:  node -e "console.log(require('bcryptjs').hashSync('YourPassword', 10))"
ADMIN_PASSWORD_HASH=

# AI assistant (optional — without a real key the assistant uses its offline answers)
ANTHROPIC_API_KEY=

# Origins allowed to call this API. Comma-separated; "*" matches one hostname part, which covers
# Vercel's per-deploy preview URLs. localhost is always allowed.
FRONTEND_URL=https://your-app.vercel.app,https://blood-donated-*-your-team.vercel.app

# Production only (both optional)
NODE_ENV=production
# TRUST_PROXY=1        # number of reverse-proxy hops in front of the server (default 1 in production)
# RATE_LIMIT_MAX=1500  # requests per IP per 15 minutes on the general API limiter
