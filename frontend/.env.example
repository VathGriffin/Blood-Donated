# Copy to .env.local for development. On Vercel, set the same names under
# Project Settings > Environment Variables — they are baked in at build time, so REDEPLOY after changing them.

# Where the backend API lives. Required in production (no trailing slash).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Optional social sign-in: the buttons only appear when these are set
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_FACEBOOK_APP_ID=
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
